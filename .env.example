# Copy to .env (Docker) or .env.local (npm run dev).

# ---- database ----------------------------------------------------------
# postgres://…       PostgreSQL (production)
# pglite://<dir>     embedded database, zero setup (local/offline mode)
# pglite://memory    embedded, in-memory (throwaway)
# Unset => postgres://csbg:csbg@localhost:5432/csbg_intake
DATABASE_URL=postgres://csbg:csbg@localhost:5432/csbg_intake

# ---- docker compose ----------------------------------------------------
# Domain Caddy should obtain certificates for (localhost = plain-HTTP trial)
CSBG_DOMAIN=localhost
# Password for the bundled PostgreSQL container
DB_PASSWORD=change-me

# ---- credential encryption --------------------------------------------
# 32-byte key (64 hex chars) encrypting stored third-party credentials, e.g.
# the PA HMIS keys. Leave unset and the app generates data/secret.key (0600)
# on first use. Either way the key lives outside the database, so a database
# dump carries no usable credential — back it up separately from the database,
# and note that losing it means re-entering those credentials.
# CSBG_SECRET_KEY=

# ---- PA HMIS (Eccovia ClientTrack API) --------------------------------
# Optional: Settings → Integrations is the primary place to configure this
# (encrypted, applied without a restart). These are the ops-managed fallback.
# Placeholders only — real keys are MOU-issued, never committed.
# HMIS_BASE_URL=https://api.clienttrack.net
# HMIS_SUBSCRIPTION_KEY=      # sent as Ocp-Apim-Subscription-Key
# HMIS_API_KEY=               # sent as Authorization: ApiKey <key>
# HMIS_ORG_ID=                # optional, User Keys only
# HMIS_PAGE_SIZE=200          # max 500; applies to CRQL queries only
# Client source: set a stored procedure and the sync uses it; leave it blank and
# the sync uses the CRQL cmClient query. Schema-qualified; a bare name becomes
# dbo.<name>. NOTE this endpoint EXECUTES whatever is named against production —
# only a read-only report procedure belongs here.
# HMIS_STORED_PROCEDURE=dbo.C_Report_Example_API
# HMIS_STORED_PROCEDURE_PARAMS={}

# ---- escape hatches ----------------------------------------------------
# LAN-only staging without TLS (disables the Secure cookie flag + HSTS).
# NEVER set this on anything reachable from the internet.
# CSBG_ALLOW_HTTP=1
